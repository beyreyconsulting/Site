# Frontend (Vite) — safe to expose, anon key is public by design
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Edge Function secrets (NEVER put these in VITE_* / the frontend) ──
# Set with the Supabase CLI, not this file:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set ALLOWED_ORIGIN=https://beyrey.consulting   # optional, locks CORS
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into Edge Functions by the platform.
#
# Functions to deploy:  kalan (AI proxy, rate-limited), enroll, sign-media (private media)
